# ASTRA MIND Health Extension — Environment Configuration Example
# ===============================================================
# Copy this file to .env and configure authorized credentials.

# Application Environment: 'development', 'test', or 'production'
ASTRA_ENV=development

# Flight Surgeon API Key (Full Medical & Telemetry Access)
ASTRA_SURGEON_API_KEY=ASTRA-SURGEON-KEY-99

# Mission Director API Key (Mission Operations & Fleet Overview)
ASTRA_MISSION_DIRECTOR_API_KEY=ASTRA-MISSION-CONTROL-2026

# Astronaut Personal API Keys (Scoped strictly to individual ID)
ASTRA_CREW_1_API_KEY=ASTRA-CREW-KEY-01
ASTRA_CREW_2_API_KEY=ASTRA-CREW-KEY-02

# Optional additional astronaut keys (comma-separated format 'TOKEN:ASTRONAUT_ID')
# ASTRA_EXTRA_CREW_KEYS=TOKEN_EVA_3:3,TOKEN_EVA_4:4
